{
	"name": "Kanidm Discord Bot",
	// https://mcr.microsoft.com/v2/devcontainers/base/tags/list
	"image": "mcr.microsoft.com/devcontainers/base:2-debian13",
	"remoteUser": "vscode",

	"features": {
		"ghcr.io/devcontainers/features/node:1": { "version": "lts" },
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
		"ghcr.io/devcontainers/features/docker-in-docker:4": {
			"version": "latest",
			"moby": false,
			"dockerDashComposeVersion": "v2"
		}
	},

	"initializeCommand": "mkdir -p \"$HOME/.claude\"",

	"mounts": [
		"source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind"
	],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
	},

	"postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && npm install -g t3",
	"postStartCommand": "setsid nohup t3 serve > /tmp/t3.log 2>&1 < /dev/null & for i in $(seq 1 60); do grep -m1 'Pairing URL' /tmp/t3.log 2>/dev/null && break; sleep 1; done",

	"forwardPorts": [3773],
	"portsAttributes": {
		"3773": { "label": "T3 Code", "onAutoForward": "silent" }
	},

	"customizations": {
		"vscode": {
			"extensions": ["anthropic.claude-code"]
		}
	}
}